msgctxt "step.when"
msgid "The day of Toreva"
msgstr "Le jour de Toreva"

#: user-scenarios/p6-break-the-glass.json:16
msgctxt "step.where"
msgid "A health tent at Toreva"
msgstr "Une tente sanitaire à Toreva"

