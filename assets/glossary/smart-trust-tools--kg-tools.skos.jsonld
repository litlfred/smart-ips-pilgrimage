        {
          "@value": "One TypeScript conformance suite for both libraries"
        }
      ],
      "skos:definition": [
        {
          "@value": "suite.ts: 45 checks over every interface of the `hcert` world, type-checked (tsc, toolchain/node) against api/generated/ts, the TypeScript jco derives from the WIT contract, and driven by the shared vectors. run.mjs runs it against the Kotlin/JS package (hcert-core's WitJs facade) or the jco-transpiled Rust component; each loader only regroups its package's exports under the interface names. Both must pass (STT-TST-007). cross.mjs loads both and runs cross.ts: each library verifies the other's ES256 and PS256 certificates, built from byte-identical Sig_structures (STT-TST-003, STT-GEN-006)."
        }
      ],
      "skos:notation": "conformance-ts",
      "dcterms:source": "smart-trust-tools/tools/conformance-ts/conformance-ts.ts#conformance-ts",
