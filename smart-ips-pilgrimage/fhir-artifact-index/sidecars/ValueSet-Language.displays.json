{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://smart.who.int/ips-pilgrimage/ValueSet-Language.displays.json",
  "title": "Language Display Values",
  "description": "Display values for Language ValueSet codes. Generated from FHIR expansions. Keys are code fragments (the part after '#' in the canonical IRI). The full IRI can be reconstructed as system + '#' + code.",
  "type": "object",
  "properties": {
    "fhir:displays": {
      "type": "object",
      "description": "Multilingual display values for ValueSet codes keyed by code fragment",
      "patternProperties": {
        "^.+$": {
          "type": "object",
          "description": "Display values for a specific code fragment by language",
          "properties": {
            "en": {
              "type": "string",
              "description": "English display value"
            }
          },
          "patternProperties": {
            "^[a-z]{2}(-[A-Z]{2})?$": {
              "type": "string",
              "description": "Display value in the specified language (ISO 639-1 code)"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "fhir:displays"
  ],
  "additionalProperties": true,
  "fhir:displays": {
    "Arabic": {
      "en": "Arabic"
    },
    "Chinese": {
      "en": "Chinese"
    },
    "English": {
      "en": "English"
    },
    "French": {
      "en": "French"
    },
    "Russian": {
      "en": "Russian"
    },
    "Spanish": {
      "en": "Spanish"
    },
    "Other": {
      "en": "Other"
    }
  },
  "fhir:valueSet": "http://smart.who.int/ips-pilgrimage/ValueSet/Language",
  "fhir:version": "2.1.0",
  "fhir:expansionTimestamp": "2026-11-10T19:26:01+00:00"
}