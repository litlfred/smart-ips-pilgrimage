CodeSystem: IPSHAJJCONSENTFr
Id: IPS.HAJJ.CONSENT-fr
Title: "Système de codes IPS.HAJJ.CONSENT"
Description: "French (fr) supplement to IPS.HAJJ.CONSENT. Unofficial agent translation."
* ^content = #supplement
* ^supplements = Canonical(IPS.HAJJ.CONSENT)
* ^language = #fr
* ^status = #draft
* ^experimental = true
* ^count = 4
* #CONSENT-KSA "Consentement pour le Royaume d’Arabie saoudite" "Le pèlerin consent à partager son résumé international du patient (données IPS) lors de la prestation de soins cliniques par le ministère de la Santé d’Arabie saoudite dans les établissements de santé de la zone du district du Hajj pendant le Hajj 1446/2025, ainsi que pour tout suivi qui pourrait être nécessaire de la part de professionnels de santé"
* #CONSENT-KSA ^designation[0].language = #fr
* #CONSENT-KSA ^designation[0].value = "Consentement pour le Royaume d’Arabie saoudite"
* #CONSENT-IDN "Consentement pour l’Indonésie" "<INSERT TEXT FROM INDONESIA: discuss pilgrims's consent to utilize Satusehat to enable access to KSA to their IPS if they are in need of care during Hajj>"
* #CONSENT-IDN ^designation[0].language = #fr
* #CONSENT-IDN ^designation[0].value = "Consentement pour l’Indonésie"
* #CONSENT-MYS "Consentement pour la Malaisie" "Le pèlerin malaisien du Hajj a consenti au partage du résumé international du patient (IPS) généré à partir des données enregistrées lors de l’examen de santé du pèlerin du Hajj, ainsi que des dossiers de vaccination conservés dans MySejahtera, avec le Royaume d’Arabie saoudite"
* #CONSENT-MYS ^designation[0].language = #fr
* #CONSENT-MYS ^designation[0].value = "Consentement pour la Malaisie"
* #CONSENT-OMN "Consentement pour Oman" "<INSERT TEXT FROM OMAN: discuss pilgrims's consent to utilize Oman's e-Health Portal to enable access to KSA to their IPS if they are in need of care>"
* #CONSENT-OMN ^designation[0].language = #fr
* #CONSENT-OMN ^designation[0].value = "Consentement pour Oman"

