CodeSystem: IPSHAJJCONSENTEs
Id: IPS-HAJJ-CONSENT-es
Title: "IPS.HAJJ.CONSENT (es designations, unofficial)"
Description: "Unofficial Spanish designations for IPS.HAJJ.CONSENT: an agent translation that no person has signed off."
* ^experimental = true
* ^content = #supplement
* ^supplements = Canonical(IPS.HAJJ.CONSENT)
* ^language = #es
* ^caseSensitive = false
* #CONSENT-KSA "Consentimiento para el Reino de la Arabia Saudita" "El peregrino consiente en compartir su Resumen Internacional del Paciente (datos del IPS) durante la prestación de atención clínica en los establecimientos de salud del Ministerio de Salud de la Arabia Saudita en la zona del distrito del Hajj durante el evento Hajj-1446/2025, así como para cualquier atención de seguimiento que pueda necesitar de cualquier profesional de la salud"
  * ^designation[0].language = #es
  * ^designation[0].value = "Consentimiento para el Reino de la Arabia Saudita"
* #CONSENT-IDN "Consentimiento para Indonesia" "<INSERTAR TEXTO DE INDONESIA: tratar el consentimiento de los peregrinos para utilizar Satusehat a fin de que el KSA acceda a su IPS si necesitan atención durante el Hajj>"
  * ^designation[0].language = #es
  * ^designation[0].value = "Consentimiento para Indonesia"
* #CONSENT-MYS "Consentimiento para Malasia" "El peregrino malasio del Hajj ha dado su consentimiento para compartir con el Reino de la Arabia Saudita el Resumen Internacional del Paciente (IPS) generado a partir de los datos registrados durante el examen de salud del peregrino del Hajj, así como los registros de vacunación almacenados en MySejahtera"
  * ^designation[0].language = #es
  * ^designation[0].value = "Consentimiento para Malasia"
* #CONSENT-OMN "Consentimiento para Omán" "<INSERTAR TEXTO DE OMÁN: tratar el consentimiento de los peregrinos para utilizar el portal de e-Salud de Omán a fin de que el KSA acceda a su IPS si necesitan atención>"
  * ^designation[0].language = #es
  * ^designation[0].value = "Consentimiento para Omán"

