     "fuzzy": false,
     "candidates": []
    },
    "es": {
     "text": "Los artefactos de prueba de esta guía de implementación no están destinados a determinar la conformidad formal, ni pretenden ser autorizados ni exhaustivos.",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "fr": {
     "text": "Les artefacts de test de ce guide d'implémentation ne sont pas destinés à être utilisés pour déterminer la conformité formelle, et ne se veulent ni faisant autorité ni exhaustifs.",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "ru": {
     "text": "Артефакты тестирования в этом руководстве по внедрению не предназначены для определения формального соответствия и не являются авторитетными или исчерпывающими.",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "zh": {
     "text": "本实施指南中的测试工件并非用于判定正式一致性，也并非旨在具有权威性或全面性。",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    }
   }
