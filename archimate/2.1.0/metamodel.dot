digraph "SMART Verifiable IPS for Pilgrimage — metamodel in use" {
  graph [rankdir=TB, newrank=true, fontname="Helvetica", fontsize=11, nodesep=0.6, ranksep=1.3];
  node [shape=box, style="filled", fontname="Helvetica", fontsize=11, margin="0.14,0.08"];
  edge [fontname="Helvetica", fontsize=9, color="#555555", fontcolor="#333333"];
  subgraph cluster_0 {
    label="Business"; class="mm-layer-business"; labeljust=l; style="rounded,filled"; fillcolor="#f7f7f7"; color="#bbbbbb"; fontcolor="#666666";
    rank=same;
    "BusinessProcess" [label="Business Process
9 element(s)
(to itself: composed of ×8, triggers ×7)", class="mm-layer-business", fillcolor="#ffffb5", URL="../../en/smart-ips-pilgrimage/archimate/2.1.0/metamodel/#type-BusinessProcess", target="_top", tooltip="Business Process: its elements"];
    "BusinessRole" [label="Business Role
5 element(s)
(to itself: flows to ×1)", class="mm-layer-business", fillcolor="#ffffb5", URL="../../en/smart-ips-pilgrimage/archimate/2.1.0/metamodel/#type-BusinessRole", target="_top", tooltip="Business Role: its elements"];
  }
  subgraph cluster_1 {
    label="Application"; class="mm-layer-application"; labeljust=l; style="rounded,filled"; fillcolor="#f7f7f7"; color="#bbbbbb"; fontcolor="#666666";
    rank=same;
    "ApplicationComponent" [label="Application Component
4 element(s)
(to itself: flows to ×4)", class="mm-layer-application", fillcolor="#b5ffff", URL="../../en/smart-ips-pilgrimage/archimate/2.1.0/metamodel/#type-ApplicationComponent", target="_top", tooltip="Application Component: its elements"];
  }
  subgraph cluster_2 {
    label="Other"; class="mm-layer-other"; labeljust=l; style="rounded,filled"; fillcolor="#f7f7f7"; color="#bbbbbb"; fontcolor="#666666";
    rank=same;
    "Location" [label="Location
2 element(s)", class="mm-layer-other", fillcolor="#ffffff", URL="../../en/smart-ips-pilgrimage/archimate/2.1.0/metamodel/#type-Location", target="_top", tooltip="Location: its elements"];
  }
  "BusinessProcess" -> "ApplicationComponent" [style=invis, constraint=true, weight=10];
  "ApplicationComponent" -> "Location" [style=invis, constraint=true, weight=10];
  "BusinessRole" -> "BusinessProcess" [label="assigned to ×19", class="mm-cat-structural mm-from-business mm-to-business", dir=both, arrowtail=dot, arrowhead=normal, URL="../../en/smart-ips-pilgrimage/archimate/2.1.0/metamodel/#pattern-BusinessRole-BusinessProcess", target="_top", tooltip="Business Role → Business Process: its relationships"];
  "ApplicationComponent" -> "BusinessProcess" [label="serves ×13", class="mm-cat-dependency mm-from-application mm-to-business", arrowhead=vee, URL="../../en/smart-ips-pilgrimage/archimate/2.1.0/metamodel/#pattern-ApplicationComponent-BusinessProcess", target="_top", tooltip="Application Component → Business Process: its relationships"];
  "Location" -> "ApplicationComponent" [label="aggregates ×3", class="mm-cat-structural mm-from-other mm-to-application", dir=both, arrowtail=odiamond, arrowhead=none, URL="../../en/smart-ips-pilgrimage/archimate/2.1.0/metamodel/#pattern-Location-ApplicationComponent", target="_top", tooltip="Location → Application Component: its relationships"];
  "BusinessRole" -> "ApplicationComponent" [label="flows to ×2", class="mm-cat-dynamic mm-from-business mm-to-application", style=dashed, arrowhead=normal, URL="../../en/smart-ips-pilgrimage/archimate/2.1.0/metamodel/#pattern-BusinessRole-ApplicationComponent", target="_top", tooltip="Business Role → Application Component: its relationships"];
  "Location" -> "BusinessRole" [label="aggregates ×1", class="mm-cat-structural mm-from-other mm-to-business", dir=both, arrowtail=odiamond, arrowhead=none, URL="../../en/smart-ips-pilgrimage/archimate/2.1.0/metamodel/#pattern-Location-BusinessRole", target="_top", tooltip="Location → Business Role: its relationships"];
}
