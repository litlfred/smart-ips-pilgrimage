    },
    "es": {
     "text": "En concreto,",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "fr": {
     "text": "Plus précisément,",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "ru": {
     "text": "А именно:",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "zh": {
     "text": "具体而言，",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    }
   }
  },
  {
   "msgid": "The message semantics for Record Consent Request utilizes a FHIR Consent resource set as PUT or POST http request.",
   "hash": "8f09ad872015f512",
   "sources": [
    "input/pagecontent/transaction-record-consent-request-message-semantics.md"
   ],
   "locales": {
    "ar": {
     "text": "تستخدم دلالات رسالة طلب Record Consent موردَ FHIR Consent مُرسَلًا في صورة طلب http من نوع PUT أو POST.",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "es": {
     "text": "La semántica del mensaje de Record Consent Request utiliza un recurso Consent de FHIR enviado como solicitud http PUT o POST.",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "fr": {
     "text": "La sémantique des messages de la requête d'enregistrement du consentement utilise une ressource FHIR Consent envoyée par une requête HTTP PUT ou POST.",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "ru": {
     "text": "Семантика сообщения запроса на регистрацию согласия использует ресурс FHIR Consent, передаваемый в HTTP-запросе PUT или POST.",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "zh": {
     "text": "记录同意请求的消息语义使用以 PUT 或 POST http 请求发送的 FHIR Consent 资源。",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    }
   }
  }
 ]
