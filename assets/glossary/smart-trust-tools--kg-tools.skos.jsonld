      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-trust-tools/v0/ns/glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "HCERT library (Rust, native and WebAssembly)"
        }
      ],
      "skos:definition": [
        {
          "@value": "The Rust implementation of the HCERT pipeline: Base45, ZLIB, deterministic CBOR, COSE_Sign1 ES256/PS256 (RustCrypto p256, rsa, sha2), CWT, the DVCMin payload, the trust store (PEM, DER, GDHCN DID trustlist v2, trust domains), the section 11 verifier, two-phase issuance and Verifiable Health Links (payload, vhlink:/, the ITI-YY5 manifest, JWE dir/A256GCM with aes-gcm, the RFC 9421 signature base). It builds natively; as the WebAssembly component of the `hcert` world in api/wit (feature component, wit-bindgen; build-component.sh componentises and transpiles it with the pinned jco into an ES module for browsers and Node, whose only import, wasi:random, maps to crypto.getRandomValues); and as an import-free module with a JSON call surface for the live demos (js/hcert.mjs, with a TEST ONLY builder of self-signed DSCs). Every crate is pinned in Cargo.lock (DEPENDENCIES.md)."
        }
      ],
      "skos:notation": "hcert-rust",
      "dcterms:source": "smart-trust-tools/tools/hcert-rust/hcert-rust.ts#hcert-rust",
      "skos:note": "candidate"
